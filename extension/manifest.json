{
  "manifest_version": 3,
  "name": "jev2mcp",
  "version": "0.2.0",
  "description": "Select MCP servers, plugins and tools from the prompt and context before sending to ChatGPT.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:4328/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "jev2mcp",
    "default_popup": "options.html"
  },
  "options_page": "options.html"
}
